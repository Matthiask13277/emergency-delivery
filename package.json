{
  "name": "emergency-delivery-desktop",
  "version": "2.0.9",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64 --publish never",
    "dist": "npm run build:win",
    "pack": "electron-builder --dir --publish never"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.emergencydelivery.desktop.v209",
    "productName": "Emergency Delivery Desktop 2.0.9",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist{,/**}",
      "!node_modules/.cache{,/**}"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Emergency-Delivery-Desktop-2.0.9.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Emergency Delivery Desktop 2.0.9",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "asar": true
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "web-push": "^3.6.7",
    "pdfkit": "^0.15.0",
    "nodemailer": "^6.9.16",
    "@electric-sql/pglite": "^0.3.14"
  },
  "description": "Emergency Delivery – Standalone Windows",
  "author": "Emergency Delivery"
}
