{
  "name": "emergency-delivery-desktop",
  "version": "2.2.2",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64 --publish never",
    "dist": "npm run build:win",
    "pack": "electron-builder --dir --publish never"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.emergencydelivery.current",
    "productName": "Emergency Delivery Desktop",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist{,/**}",
      "!node_modules/.cache{,/**}"
    ],
    "win": {
      "icon": "emergency-delivery.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ED-CURRENT-DESKTOP-2.2.2-Portable.${ext}"
    },
    "asar": true,
    "artifactName": "ED-CURRENT-DESKTOP-2.2.2.${ext}",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Emergency Delivery",
      "uninstallDisplayName": "Emergency Delivery",
      "deleteAppDataOnUninstall": false,
      "artifactName": "ED-CURRENT-DESKTOP-2.2.2-Setup.${ext}"
    }
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "web-push": "^3.6.7",
    "pdfkit": "^0.15.0",
    "nodemailer": "^6.9.16",
    "@electric-sql/pglite": "^0.3.14"
  },
  "description": "Emergency Delivery – Standalone Windows",
  "author": "Emergency Delivery"
}
